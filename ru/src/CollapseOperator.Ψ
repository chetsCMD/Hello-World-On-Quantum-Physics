// Коллапс волновой функции в момент вывода строки на экран
класс CollapseOperator {
    поле выход : |Hello, World⟩          // пиксельная конфигурация строки
    поле наблюдатель : Observer

    // Проекционный оператор измерения «на экране написано Hello, World»
    метод P̂() → оператор := |Hello, World⟩⟨Hello, World|
    // Вероятность исхода по правилу Борна
    метод вероятность(Ψ : WaveFunction) → вероятность := ⟨Ψ| P̂ |Ψ⟩
    // Коллапс: состояние после измерения
    метод коллапс(Ψ : WaveFunction) → WaveFunction := P̂|Ψ⟩ / √⟨Ψ|P̂|Ψ⟩
    // Момент коллапса задаётся временем декогеренции наблюдателя
    метод момент() → с := наблюдатель.τ_D
}
