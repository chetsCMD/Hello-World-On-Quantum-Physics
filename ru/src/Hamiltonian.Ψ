// Энергетический предел скорости вычислений
класс Hamiltonian {
    поле m : кг = 1                                  // масса «ультимативного» компьютера
    метод E()     → Дж := m · c²                     // ≈ 8.99e16
    // Теорема Марголуса–Левитина: максимум ортогональных переходов в секунду
    метод Γ_max() → 1/с := 2·E / (π·ħ)               // ≈ 5.43e50
    метод log10_Γ() → число := log₁₀(Γ_max)          // 50.734
}
