// ТОЧКА ВХОДА. Вычисляет, сколько ждать, пока компьютер сам напишет «Hello, World».
класс HelloWorldUniverse {
    поле образ    : ProgramImage        = ProgramImage.минимальный_ELF()
    поле оценка   : WaitingTimeEstimator = { образ = образ }
    поле время    : UniverseTimeline
    поле Ψ        : WaveFunction        = WaveFunction.равномерная(образ.N)
    поле коллапс  : CollapseOperator    = { наблюдатель = Observer }

    метод запустить() := {
        1. P := образ.P()                                  // 2^−1024 ≈ 5.6e-309
        2. T_A, T_B, T_C := оценка.log10_T_A, T_B, T_C     // 257.5, 11165.8, 8574.9 (с)
        3. вероятность_за_жизнь := время.P_за_жизнь(T_A)   // ≈ 10^−239.9
        4. ждать(T_A)                                      // ≈ 10^250 лет
        5. когда |H⟩ возник в памяти → процессор исполняет образ
        6. коллапс.коллапс(Ψ)                              // пиксели фиксируются за ≈ 1.5e-20 с
        7. вывод := "Hello, World"
    }

    метод ждать(log10_T) := терпение
}
