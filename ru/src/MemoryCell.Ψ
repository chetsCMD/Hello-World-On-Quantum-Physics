// Ячейка памяти как барьер: электрон туннелирует через слой SiO₂ (ВКБ)
класс MemoryCell {
    поле V : Дж  = 3.1·eV          // высота барьера Si/SiO₂
    поле m : кг  = 0.5·mₑ          // эффективная масса электрона
    поле d : м   = 5e-9            // толщина барьера

    метод κ()  → 1/м := √(2·m·V) / ħ
    метод T()  → вероятность := exp(−2·κ·d)          // ≈ 1.99e-28
    метод ν()  → Гц := V / h                          // частота попыток ≈ 7.50e14
    // Скорость туннелирования на бит
    метод r()  → 1/с := ν · T                         // ≈ 1.49e-13
}
