// Наблюдатель = любая система, необратимо записывающая информацию (декогеренция)
класс Observer {
    поле T  : К   = 300
    поле m  : кг  = mₑ
    поле Δx : м   = 1e-6                   // масштаб различимых пиксельных состояний
    поле τ_R: с   = 1e-14                  // время релаксации

    метод λ_th() → м := ħ / √(2·m·k_B·T)           // ≈ 1.2e-9
    // Время декогеренции: насколько быстро пиксельный базис становится классическим
    метод τ_D() → с := τ_R · (λ_th / Δx)²          // ≈ 1.5e-20
    // Человек не обязателен: экран, фотоны и воздух уже наблюдают
    метод человек_обязателен() → логика := ложь
}
