// Образ программы «Hello, World»: набор бит, которые должны возникнуть сами
класс ProgramImage {
    поле L : Б                        // размер образа в байтах (по умолчанию 128)
    поле H : |h₁h₂…h_N⟩               // целевая битовая конфигурация

    метод N() → бит := 8·L
    // Чистая вероятность одной конфигурации (принцип безразличия)
    метод P() → вероятность := 2^(−N)
    метод log10_P() → число := −N · log₁₀(2)

    // Предустановки
    метод минимальный_ELF()   → ProgramImage := { L = 128 }
    метод только_текст()      → ProgramImage := { L = 22  }   // print("Hello, World"), нужен интерпретатор
    метод расширенный_ELF()   → ProgramImage := { L = 142 }
}
