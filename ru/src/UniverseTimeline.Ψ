// Шкала времени: возраст Вселенной и вероятность успеха за него
класс UniverseTimeline {
    поле U : с = 4.35e17                           // ≈ 1.38e10 лет
    метод log10_U() → число := log₁₀(U)            // 17.64
    // При T ≫ U вероятность успеха ≈ U / T
    метод P_за_жизнь(log10_T : число) → число := log10_U − log10_T
}
