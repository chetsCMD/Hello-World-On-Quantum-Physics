// Три модели времени ожидания (все результаты в log₁₀ секунд)
класс WaitingTimeEstimator {
    поле образ : ProgramImage
    поле ячейка : MemoryCell
    поле лучи : CosmicRaySource
    поле гамильтониан : Hamiltonian
    поле K : число = 1                    // число допустимых позиций образа

    // n = число неверных бит, которые должны перевернуться
    метод n() → бит := N / 2

    // A: предел Марголуса–Левитина. T = 2^N / (K·Γ_max)
    метод log10_T_A() → число := N·log₁₀(2) − log₁₀(K) − гамильтониан.log10_Γ

    // B: туннелирование. T = Δt / (K·(rΔt)^n), Δt = 1 нс
    метод log10_T_B() → число := −n·log₁₀(ячейка.r · 1e-9) + log₁₀(1e-9) − log₁₀(K)

    // C: космические лучи. T = Δt / (K·(rΔt)^n), Δt = 64 мс
    метод log10_T_C() → число := −n·log₁₀(лучи.r · лучи.Δt) + log₁₀(лучи.Δt) − log₁₀(K)

    // Перевод в годы
    метод в_годах(log10_T_с) → число := log10_T_с − log₁₀(год)
}
// Для L = 128: A ≈ 257.52, B ≈ 11165.8, C ≈ 8574.9  (log₁₀ секунд)
