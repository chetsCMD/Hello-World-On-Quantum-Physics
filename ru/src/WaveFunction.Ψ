// Состояние памяти как вектор в пространстве размерности 2^N
класс WaveFunction {
    поле N  : бит
    поле c  : вектор[2^N]                // амплитуды c_x

    // Нормировка
    метод норма() → число := Σₓ |c_x|² = 1
    // Правило Борна: вероятность найти память в состоянии |H⟩
    метод P(H : ProgramImage) → вероятность := |⟨H|Ψ⟩|²
    // Равномерная (максимально смешанная) начальная суперпозиция
    метод равномерная(N) → WaveFunction := { c_x = 2^(−N/2) }
}
